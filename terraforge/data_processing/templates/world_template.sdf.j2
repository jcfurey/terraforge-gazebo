<?xml version='1.0'?>
<sdf version='1.10'>
  <world name='generated_world'>

    <!-- 4 ms step (250 Hz physics). 1 ms put gzserver at ~20% RTF on the
         Vicksburg-scale world (370 static collisions + heightmap). 4 ms is
         comfortable for bullet-featherstone on a ground vehicle and restores
         RTF close to 1.0 without noticeably degrading wheel/contact fidelity. -->
    <physics name='4ms' type='ignored'>
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Physics engine: bullet-featherstone (NOT gazebo's default dartsim).
         Rationale: dartsim does not implement SDF <heightmap> collision nor
         <polyline> collision, which forced a flat ground-plane hack and
         disabled road collision. bullet-featherstone supports both natively,
         so the rover can actually drive on terrain and interact with roads /
         building outlines. Ships with gz-physics-7 on ROS 2 Jazzy (the
         `libgz-physics-bullet-featherstone-plugin.so` symlink in
         `ros-jazzy-gz-physics-vendor`). The <filename> value must be the
         library basename without `lib` prefix or `.so` suffix. -->
    <plugin filename='gz-sim-physics-system'
            name='gz::sim::systems::Physics'>
      <engine>
        <filename>gz-physics-bullet-featherstone-plugin</filename>
      </engine>
    </plugin>
    <plugin filename='gz-sim-user-commands-system'
            name='gz::sim::systems::UserCommands'/>
    <plugin filename='gz-sim-scene-broadcaster-system'
            name='gz::sim::systems::SceneBroadcaster'/>
    <plugin filename='gz-sim-sensors-system'
            name='gz::sim::systems::Sensors'>
      <render_engine>ogre2</render_engine>
    </plugin>
    <!-- IMU system: populates the LinearAcceleration / AngularVelocity
         components that sensors (incl. gz_sensors_ouster's synthesised IMU)
         read. Without this, a static rover's IMU reports 0 m/s² on all axes
         instead of +9.81 on Z, and Madgwick flags 'IMU in free fall'. -->
    <plugin filename='gz-sim-imu-system'
            name='gz::sim::systems::Imu'/>
    <!-- Contact system: populates contact-sensor topics. Matches the standard
         plugin set used by the bundled SubT/warehouse worlds. -->
    <plugin filename='gz-sim-contact-system'
            name='gz::sim::systems::Contact'/>

    <!-- Shadows disabled globally. On a large world (100s of static models)
         every shadow caster adds a depth-pass in the ogre2 renderer; turning
         the sun's cast_shadows + scene-level <shadows> off typically buys
         20-40% RTF with no perception impact (LiDAR / depth cams don't read
         the shadow pass). Re-enable both for visual beauty-shots. -->
    <light name='sun' type='directional'>
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <scene>
      <!-- gz-sim Harmonic's <sky> element is flaky on our setup (hangs the
           GUI render thread when clouds are enabled), so skip it and just
           paint a sky-blue background. -->
      <ambient>0.5 0.5 0.5 1</ambient>
      <background>0.5 0.7 1.0 1</background>
      <shadows>false</shadows>
      <!-- "Fog of war" atmospheric haze. Colour matches the sky so distant
           tiles blend out naturally. linear fog is cheap (1 per-pixel math
           op) and hides the sharp edge where the static scene ends or where
           level-streamed tiles would pop in. Tune <start>/<end> to push the
           visible horizon in or out; they're in world metres. -->
      <fog>
        <type>linear</type>
        <color>0.5 0.7 1.0 1</color>
        <start>80</start>
        <end>260</end>
      </fog>
    </scene>

    <!-- Flat collision plane — the ONLY collision surface in this world.
         gz-sim's bullet-featherstone physics backend does NOT implement
         AttachHeightmapShapeFeature, so any <heightmap> under <collision>
         is silently dropped at world load with:
           [Err] Unsupported collision geometry type [6] for Link [link]
           [Dbg] Heightmaps will be ignored.
         dartsim doesn't support heightmap collision either. The heightmap
         is therefore a VISUAL-only surface — the rover drives on this
         flat plane at z=0 while seeing the elevated terrain around it.
         Buildings / trees float or sink relative to this plane based on
         their DEM elevation; that's cosmetic and doesn't affect physics.
         Upgrade path: pre-triangulate the heightmap to an STL and use
         <mesh> collision instead (bullet-featherstone supports that). -->
    <model name='ground_plane'>
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name='link'>
        <collision name='collision'>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>{{ extent_meters }} {{ extent_meters }}</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>100</mu>
                <mu2>50</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        {% if not heightmap_path %}
        <visual name='visual'>
          <cast_shadows>false</cast_shadows>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>{{ extent_meters }} {{ extent_meters }}</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
        {% endif %}
      </link>
    </model>

    {% if heightmap_path %}
    <!-- Terrain is VISUAL ONLY. No <collision> block: gz-sim's
         bullet-featherstone and dartsim physics backends both reject
         <heightmap> collision ("Unsupported collision geometry type [6]"
         / "Heightmaps will be ignored"). The rover drives on the flat
         <ground_plane> above instead; this model just renders the DEM
         so the scene looks like real terrain.

         <pos> is shifted by terrain_z_offset so the DEM elevation at
         the origin (lat/lon center) corresponds to sim z=0; without it
         the SDF heightmap's minimum elevation maps to z=0 and everything
         near the origin gets buried under ~half the relief. -->
    <model name='terrain'>
      <static>true</static>
      <link name='link'>
        <visual name='visual'>
          <geometry>
            <heightmap>
              <uri>file://{{ heightmap_path }}</uri>
              <size>{{ extent_meters }} {{ extent_meters }} {{ height_amplitude }}</size>
              <pos>0 0 {{ terrain_z_offset }}</pos>
              {% if texture_path %}
              <!-- NOTE: <normal> points at a FLAT normal map (all pixels
                   RGB(128, 128, 255) = tangent-space up). We cannot just
                   reuse the diffuse satellite PNG here — the parser treats
                   its RGB pixels as XYZ surface-gradient encoding, which
                   renders fake specular highlights on flat surfaces like
                   parking lots and rooftops (the "shiny" look). We also
                   cannot omit <normal>: sdf1.10 defaults it to __default__,
                   and gz-sim's parser aborts with "uri [__default__] could
                   not be resolved" on load. A flat normal PNG is the
                   minimum valid stand-in. -->
              <texture>
                <size>{{ extent_meters }}</size>
                <diffuse>file://{{ texture_path }}</diffuse>
                <normal>file://{{ flat_normal_path }}</normal>
              </texture>
              {% endif %}
            </heightmap>
          </geometry>
        </visual>
      </link>
      <pose>0 0 0 0 0 0</pose>
    </model>
    {% endif %}

    <!-- ── Static scene as tiled compound models ─────────────────────────
         All buildings, trees, and roads are bucketed into 200 m × 200 m
         tile models, each containing the unique links that fall inside
         its extent. When level streaming is on (below), only the tiles
         near the rover get loaded. -->
    {% for tile in scene_tiles %}
{{ tile.model_sdf }}
    {% endfor %}

    {% if enable_level_streaming %}
    <!-- ── Tile streaming via custom plugin ──────────────────────────────
         SDFormat's native <level>/<performer> tags only take effect in
         distributed-simulation mode and are silently dropped by our
         single-process launch. Instead, gz_tile_streamer::TileStreamer
         watches the performer model's pose every tick and teleports
         out-of-range tile_X_Y models to z={{ level_hidden_z }} m so they
         fall out of the render + physics active set. Fog in <scene>
         masks the activation boundary so tiles popping in at the edge
         fade from haze into detail. Requires:
             colcon build --packages-select gz_tile_streamer
         and GZ_SIM_SYSTEM_PLUGIN_PATH must include install/lib. -->
    <plugin filename='gz_tile_streamer' name='gz_tile_streamer::TileStreamer'>
      <performer_model>{{ performer_ref }}</performer_model>
      <tile_prefix>tile_</tile_prefix>
      <active_radius_m>{{ level_active_radius_m }}</active_radius_m>
      <hidden_z>{{ level_hidden_z }}</hidden_z>
      <update_rate_hz>10</update_rate_hz>
    </plugin>
    {% endif %}

  </world>
</sdf>
