<?xml version='1.0'?>
<sdf version='1.10'>
  <world name='generated_world'>

    <physics name='1ms' type='ignored'>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Physics engine: bullet-featherstone (NOT gazebo's default dartsim).
         Rationale: dartsim does not implement SDF <heightmap> collision nor
         <polyline> collision, which forced a flat ground-plane hack and
         disabled road collision. bullet-featherstone supports both natively,
         so the rover can actually drive on terrain and interact with roads /
         building outlines. Ships with gz-physics-7 on ROS 2 Jazzy (the
         `libgz-physics-bullet-featherstone-plugin.so` symlink in
         `ros-jazzy-gz-physics-vendor`). The <filename> value must be the
         library basename without `lib` prefix or `.so` suffix. -->
    <plugin filename='gz-sim-physics-system'
            name='gz::sim::systems::Physics'>
      <engine>
        <filename>gz-physics-bullet-featherstone-plugin</filename>
      </engine>
    </plugin>
    <plugin filename='gz-sim-user-commands-system'
            name='gz::sim::systems::UserCommands'/>
    <plugin filename='gz-sim-scene-broadcaster-system'
            name='gz::sim::systems::SceneBroadcaster'/>
    <plugin filename='gz-sim-sensors-system'
            name='gz::sim::systems::Sensors'>
      <render_engine>ogre2</render_engine>
    </plugin>
    <!-- IMU system: populates the LinearAcceleration / AngularVelocity
         components that sensors (incl. gz_sensors_ouster's synthesised IMU)
         read. Without this, a static rover's IMU reports 0 m/s² on all axes
         instead of +9.81 on Z, and Madgwick flags 'IMU in free fall'. -->
    <plugin filename='gz-sim-imu-system'
            name='gz::sim::systems::Imu'/>
    <!-- Contact system: populates contact-sensor topics. Matches the standard
         plugin set used by the bundled SubT/warehouse worlds. -->
    <plugin filename='gz-sim-contact-system'
            name='gz::sim::systems::Contact'/>

    <light name='sun' type='directional'>
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>

    <!-- Flat collision plane — always emitted.
         Gazebo's dartsim physics engine cannot build collision from an SDF
         <heightmap> (see gz-sim issue tracker). Without a fallback plane the
         robot falls through the terrain. The heightmap below is visual-only
         on dartsim; for true terrain-following physics switch the engine to
         bullet-featherstone. When no heightmap is present this plane also
         carries the visual. -->
    <model name='ground_plane'>
      <static>true</static>
      <link name='link'>
        <collision name='collision'>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>{{ extent_meters }} {{ extent_meters }}</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>100</mu>
                <mu2>50</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        {% if not heightmap_path %}
        <visual name='visual'>
          <cast_shadows>false</cast_shadows>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>{{ extent_meters }} {{ extent_meters }}</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
        {% endif %}
      </link>
    </model>

    {% if heightmap_path %}
    <!-- Terrain. <pos> is shifted by terrain_z_offset so the DEM elevation at
         the origin (lat/lon center) corresponds to sim z=0. Without this the
         SDF heightmap's minimum elevation maps to z=0, burying everything near
         the origin under ~half the relief. -->
    <model name='terrain'>
      <static>true</static>
      <link name='link'>
        <collision name='collision'>
          <geometry>
            <heightmap>
              <uri>file://{{ heightmap_path }}</uri>
              <size>{{ extent_meters }} {{ extent_meters }} {{ height_amplitude }}</size>
              <pos>0 0 {{ terrain_z_offset }}</pos>
            </heightmap>
          </geometry>
        </collision>
        <visual name='visual'>
          <geometry>
            <heightmap>
              <uri>file://{{ heightmap_path }}</uri>
              <size>{{ extent_meters }} {{ extent_meters }} {{ height_amplitude }}</size>
              <pos>0 0 {{ terrain_z_offset }}</pos>
              {% if texture_path %}
              <!-- NOTE: <normal> points at a FLAT normal map (all pixels
                   RGB(128, 128, 255) = tangent-space up). We cannot just
                   reuse the diffuse satellite PNG here — the parser treats
                   its RGB pixels as XYZ surface-gradient encoding, which
                   renders fake specular highlights on flat surfaces like
                   parking lots and rooftops (the "shiny" look). We also
                   cannot omit <normal>: sdf1.10 defaults it to __default__,
                   and gz-sim's parser aborts with "uri [__default__] could
                   not be resolved" on load. A flat normal PNG is the
                   minimum valid stand-in. -->
              <texture>
                <size>{{ extent_meters }}</size>
                <diffuse>file://{{ texture_path }}</diffuse>
                <normal>file://{{ flat_normal_path }}</normal>
              </texture>
              {% endif %}
            </heightmap>
          </geometry>
        </visual>
      </link>
      <pose>0 0 0 0 0 0</pose>
    </model>
    {% endif %}

    {% for building in buildings %}
    <include>
      <name>{{ building.model_name }}</name>
      <uri>model://{{ building.model_name }}</uri>
      <pose>{{ building.pose_xy[0] }} {{ building.pose_xy[1] }} {{ building.pose_z | default(0) }} 0 0 0</pose>
    </include>
    {% endfor %}

    {% for road in roads %}
    <include>
      <name>{{ road.model_name }}</name>
      <uri>model://{{ road.model_name }}</uri>
      <pose>{{ road.pose_xy[0] }} {{ road.pose_xy[1] }} {{ road.pose_z | default(0) }} 0 0 0</pose>
    </include>
    {% endfor %}

    {% for tree in trees %}
    <!-- tree placements reuse shared tree_generic_N models (<name> unique) -->
    <include>
      <name>tree_{{ loop.index }}</name>
      <uri>model://{{ tree.model_name }}</uri>
      <pose>{{ tree.pose_xy[0] }} {{ tree.pose_xy[1] }} {{ tree.pose_z | default(0) }} 0 0 0</pose>
    </include>
    {% endfor %}

  </world>
</sdf>
