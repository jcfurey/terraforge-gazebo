<?xml version='1.0'?>
<sdf version='1.10'>
  <world name='generated_world'>

    <!-- 4 ms step (250 Hz physics). 1 ms put gzserver at ~20% RTF on the
         Vicksburg-scale world (370 static collisions + heightmap). 4 ms is
         comfortable for bullet-featherstone on a ground vehicle and restores
         RTF close to 1.0 without noticeably degrading wheel/contact fidelity. -->
    <physics name='4ms' type='ignored'>
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Physics engine: bullet-featherstone (NOT gazebo's default dartsim).
         Rationale: dartsim does not implement SDF <heightmap> collision nor
         <polyline> collision, which forced a flat ground-plane hack and
         disabled road collision. bullet-featherstone supports both natively,
         so the rover can actually drive on terrain and interact with roads /
         building outlines. Ships with gz-physics-7 on ROS 2 Jazzy (the
         `libgz-physics-bullet-featherstone-plugin.so` symlink in
         `ros-jazzy-gz-physics-vendor`). The <filename> value must be the
         library basename without `lib` prefix or `.so` suffix. -->
    <plugin filename='gz-sim-physics-system'
            name='gz::sim::systems::Physics'>
      <engine>
        <filename>gz-physics-bullet-featherstone-plugin</filename>
      </engine>
    </plugin>
    <plugin filename='gz-sim-user-commands-system'
            name='gz::sim::systems::UserCommands'/>
    <plugin filename='gz-sim-scene-broadcaster-system'
            name='gz::sim::systems::SceneBroadcaster'/>
    <plugin filename='gz-sim-sensors-system'
            name='gz::sim::systems::Sensors'>
      <render_engine>ogre2</render_engine>
    </plugin>
    <!-- IMU system: populates the LinearAcceleration / AngularVelocity
         components that sensors (incl. gz_sensors_ouster's synthesised IMU)
         read. Without this, a static rover's IMU reports 0 m/s² on all axes
         instead of +9.81 on Z, and Madgwick flags 'IMU in free fall'. -->
    <plugin filename='gz-sim-imu-system'
            name='gz::sim::systems::Imu'/>
    <!-- Contact system: populates contact-sensor topics. Matches the standard
         plugin set used by the bundled SubT/warehouse worlds. -->
    <plugin filename='gz-sim-contact-system'
            name='gz::sim::systems::Contact'/>

    <!-- Shadows disabled globally. On a large world (100s of static models)
         every shadow caster adds a depth-pass in the ogre2 renderer; turning
         the sun's cast_shadows + scene-level <shadows> off typically buys
         20-40% RTF with no perception impact (LiDAR / depth cams don't read
         the shadow pass). Re-enable both for visual beauty-shots. -->
    <light name='sun' type='directional'>
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <scene>
      <!-- gz-sim Harmonic's <sky> element is flaky on our setup (hangs the
           GUI render thread when clouds are enabled), so skip it and just
           paint a sky-blue background. -->
      <ambient>0.5 0.5 0.5 1</ambient>
      <background>0.5 0.7 1.0 1</background>
      <shadows>false</shadows>
      <!-- "Fog of war" haze. Deliberately a cool neutral grey — NOT the
           sky-blue <background> colour — so distance reads as fog rolling
           in, not as a flat cutoff to open sky. Fog only tints rendered
           geometry, so the sky above the horizon stays blue; only the
           ground / buildings / trees fade to grey with distance.
           <end> must sit inside the level-active radius (see <buffer>
           below) so tiles are fully obscured by the time they load,
           hiding pop-in. linear fog is cheap (1 per-pixel math op). -->
      <fog>
        <type>linear</type>
        <color>0.6 0.6 0.62 1</color>
        <start>40</start>
        <end>180</end>
      </fog>
    </scene>

    <!-- Flat collision plane — the ONLY collision surface in this world.
         gz-sim's bullet-featherstone physics backend does NOT implement
         AttachHeightmapShapeFeature, so any <heightmap> under <collision>
         is silently dropped at world load with:
           [Err] Unsupported collision geometry type [6] for Link [link]
           [Dbg] Heightmaps will be ignored.
         dartsim doesn't support heightmap collision either. The heightmap
         is therefore a VISUAL-only surface — the rover drives on this
         flat plane at z=0 while seeing the elevated terrain around it.
         Buildings / trees float or sink relative to this plane based on
         their DEM elevation; that's cosmetic and doesn't affect physics.
         Upgrade path: pre-triangulate the heightmap to an STL and use
         <mesh> collision instead (bullet-featherstone supports that). -->
    <model name='ground_plane'>
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name='link'>
        <collision name='collision'>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>{{ extent_meters }} {{ extent_meters }}</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>100</mu>
                <mu2>50</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        {% if not heightmap_path %}
        <visual name='visual'>
          <cast_shadows>false</cast_shadows>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>{{ extent_meters }} {{ extent_meters }}</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
        {% endif %}
      </link>
    </model>

    {% if heightmap_path %}
    <!-- Terrain is VISUAL ONLY. No <collision> block: gz-sim's
         bullet-featherstone and dartsim physics backends both reject
         <heightmap> collision ("Unsupported collision geometry type [6]"
         / "Heightmaps will be ignored"). The rover drives on the flat
         <ground_plane> above instead; this model just renders the DEM
         so the scene looks like real terrain.

         <pos> is shifted by terrain_z_offset so the DEM elevation at
         the origin (lat/lon center) corresponds to sim z=0; without it
         the SDF heightmap's minimum elevation maps to z=0 and everything
         near the origin gets buried under ~half the relief. -->
    <model name='terrain'>
      <static>true</static>
      <link name='link'>
        <visual name='visual'>
          <geometry>
            <heightmap>
              <uri>file://{{ heightmap_path }}</uri>
              <size>{{ extent_meters }} {{ extent_meters }} {{ height_amplitude }}</size>
              <pos>0 0 {{ terrain_z_offset }}</pos>
              {% if texture_path %}
              <!-- NOTE: <normal> points at a FLAT normal map (all pixels
                   RGB(128, 128, 255) = tangent-space up). We cannot just
                   reuse the diffuse satellite PNG here — the parser treats
                   its RGB pixels as XYZ surface-gradient encoding, which
                   renders fake specular highlights on flat surfaces like
                   parking lots and rooftops (the "shiny" look). We also
                   cannot omit <normal>: sdf1.10 defaults it to __default__,
                   and gz-sim's parser aborts with "uri [__default__] could
                   not be resolved" on load. A flat normal PNG is the
                   minimum valid stand-in. -->
              <texture>
                <size>{{ extent_meters }}</size>
                <diffuse>file://{{ texture_path }}</diffuse>
                <normal>file://{{ flat_normal_path }}</normal>
              </texture>
              {% endif %}
            </heightmap>
          </geometry>
        </visual>
      </link>
      <pose>0 0 0 0 0 0</pose>
    </model>
    {% endif %}

    <!-- ── Static scene as tiled compound models ─────────────────────────
         All buildings, trees (cartoon mode), and roads are bucketed into
         200 m × 200 m tile models, each containing the unique links that
         fall inside its extent. When level streaming is on (below), only
         the tiles near the rover get loaded.

         Fuel-mode trees are NOT in these compounds — SDF's `<include>`
         is invalid inside `<model>`, so fuel trees are emitted as
         top-level includes below and attached to the matching tile's
         `<level>` via extra `<ref>` entries so streaming still culls
         them with their tile. -->
    {% for tile in scene_tiles if tile.has_compound_model %}
{{ tile.model_sdf }}
    {% endfor %}

    {% if fuel_tree_includes_sdf %}
    <!-- ── Fuel-mode trees (top-level includes) ──────────────────────────
         Emitted only when `--foliage-style fuel` was passed to
         `terraforge generate-world`. Each `<include>` resolves
         `model://tree_fuel_<variant>` against `GZ_SIM_RESOURCE_PATH` —
         the workspace-committed `models_fuel/` wrappers, which in turn
         `<include>` real Gazebo Fuel meshes (OpenRobotics/Oak tree +
         Pine Tree). Fuel downloads land in `~/.gz/fuel/` which is
         bind-mounted from the `gz-cache` docker volume on this
         workspace, so they persist across container restarts. -->
{{ fuel_tree_includes_sdf }}
    {% endif %}

    {% if enable_level_streaming %}
    <!-- ── Performer placeholder ─────────────────────────────────────────
         gz-sim's LevelManager binds <performer><ref> to a top-level
         model at world LOAD time. The real rover URDF is spawned later
         by ros_gz_sim::create, so without this stub the binding fails
         with:
           [Err] Unable to find performer parent entity with name[...].
           This performer will not adhere to levels.
         Ship a tiny invisible static model sharing the performer's
         name so the binding succeeds at load. The launch sequence
         (bringup_sim_erdc/launch/gazebo.launch.py) calls
         /world/<name>/remove on this placeholder just before spawning
         the real rover so the names don't collide. -->
    <model name="{{ performer_ref }}">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="anchor">
        <visual name="v">
          <transparency>1.0</transparency>
          <geometry><sphere><radius>0.01</radius></sphere></geometry>
        </visual>
      </link>
    </model>

    <!-- ── Native gz-sim level streaming ─────────────────────────────────
         SDFormat <level>/<performer> elements DO work in single-process
         gz-sim 8, but only when:
           (a) the world is launched with `gz sim --levels` (off by
               default — SimulationRunner gates LevelManager on
               ServerConfig::UseLevels(), which is only true when the
               CLI flag or `--network-role` is set), AND
           (b) the performer/level definitions sit inside a
               <plugin name="gz::sim" filename="dummy"> block (the literal
               `dummy` filename is load-bearing: gz-sim's SDF parser
               extracts the <performer>/<level> children out of this
               plugin block before rejecting the fake library).
         Once both hold, LevelManager::UnloadInactiveEntities calls
         ecm.RequestRemoveEntity on every entity in a level when no
         performer's bounding volume intersects the level's AABB + buffer
         — the same mechanism our retired gz_tile_streamer hand-rolled.

         <buffer> is the hysteresis margin (metres) extending each level's
         AABB. A performer entering the extended box loads the level; it
         unloads only after the performer exits the base AABB. Set buffer
         generously to avoid load/unload thrashing when the rover drives
         parallel to a tile edge.

         Fog in <scene> masks the activation boundary so tiles popping
         in at the edge fade from haze into detail. The rover and any
         world-scope props (ground_plane, terrain visual, lights) stay
         in the implicit `default` level and are always loaded. -->
    <plugin name="gz::sim" filename="dummy">
      <performer name="perf_{{ performer_ref }}">
        <ref>{{ performer_ref }}</ref>
        <geometry>
          <box>
            <size>2 2 2</size>
          </box>
        </geometry>
      </performer>
      {% for tile in scene_tiles %}
      <level name="level_{{ tile.tile_id }}">
        <pose>{{ tile.center_x }} {{ tile.center_y }} 0 0 0 0</pose>
        <geometry>
          <box>
            <!-- Z extent derived from terrain height_amplitude + slack
                 (see BUILDING_Z_SLACK_M in sdf_builder.py) so a rover on
                 a ridge top or a tall building's roof still reads as
                 inside this level's AABB. -->
            <size>{{ tile.size_xy }} {{ tile.size_xy }} {{ "%.1f"|format(level_z_extent_m) }}</size>
          </box>
        </geometry>
        <buffer>{{ level_buffer_m }}</buffer>
        {% if tile.has_compound_model %}
        <ref>{{ tile.tile_id }}</ref>
        {% endif %}
        {% for tree_name in tile.fuel_tree_names %}
        <ref>{{ tree_name }}</ref>
        {% endfor %}
      </level>
      {% endfor %}
    </plugin>
    {% endif %}

  </world>
</sdf>
